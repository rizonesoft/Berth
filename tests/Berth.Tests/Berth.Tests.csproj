<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- The layer rule's fixtures reference Windows Forms and a generated COM interface. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Berth.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Program.cs replaces xUnit's generated entry point so the test assembly can also run as a helper process. -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
  </PropertyGroup>

  <ItemGroup>
    <!-- The C# parser, so the layer rule reads Core's source files as the compiler does. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="xunit.v3" />
    <Using Include="System.IO" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Berth\Berth.csproj" />
  </ItemGroup>

  <!-- The layer rule parses Core's sources with the symbols berth.exe is compiled with, so #if cannot hide a type. -->
  <Target Name="EmbedBerthDefineConstants" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="..\..\src\Berth\Berth.csproj" Targets="GetBerthDefineConstants" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="BerthDefineConstants" />
    </MSBuild>
    <ItemGroup>
      <AssemblyMetadata Include="BerthDefineConstants" Value="$(BerthDefineConstants)" />
    </ItemGroup>
  </Target>

</Project>
