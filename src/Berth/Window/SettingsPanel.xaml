<UserControl x:Class="Berth.Window.SettingsPanel"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="FluentToggleSwitchStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="MinHeight" Value="{DynamicResource Berth.ControlHeight}" />
            <Setter Property="MinWidth" Value="{DynamicResource Berth.ToggleTrackWidth}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{DynamicResource Berth.Space.None}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent"
                              MinHeight="{DynamicResource Berth.ControlHeight}">
                            <Border x:Name="Track"
                                    Width="{DynamicResource Berth.ToggleTrackWidth}"
                                    Height="{DynamicResource Berth.ToggleTrackHeight}"
                                    CornerRadius="{DynamicResource Berth.RadiusToggleTrack}"
                                    Background="{DynamicResource ToggleSwitchFillOff}"
                                    BorderBrush="{DynamicResource ToggleSwitchStrokeOff}"
                                    BorderThickness="{DynamicResource Berth.Space.BorderThin}"
                                    Padding="{DynamicResource Berth.Space.ToggleKnobPadding}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                                <Border x:Name="Knob"
                                        Width="{DynamicResource Berth.ToggleKnob}"
                                        Height="{DynamicResource Berth.ToggleKnob}"
                                        CornerRadius="{DynamicResource Berth.RadiusToggleKnob}"
                                        Background="{DynamicResource ToggleSwitchKnobFillOff}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOffPointerOver}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOffPointerOver}" />
                                <Setter TargetName="Knob" Property="Background" Value="{DynamicResource ToggleSwitchKnobFillOffPointerOver}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOn}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOn}" />
                                <Setter TargetName="Knob" Property="Background" Value="{DynamicResource ToggleSwitchKnobFillOn}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOnPointerOver}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOnPointerOver}" />
                                <Setter TargetName="Knob" Property="Background" Value="{DynamicResource ToggleSwitchKnobFillOnPointerOver}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOffDisabled}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOffDisabled}" />
                                <Setter TargetName="Knob" Property="Background" Value="{DynamicResource ToggleSwitchKnobFillOffDisabled}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsEnabled" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOnDisabled}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOnDisabled}" />
                                <Setter TargetName="Knob" Property="Background" Value="{DynamicResource ToggleSwitchKnobFillOnDisabled}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Height="{DynamicResource Berth.Divider}"
                Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                IsHitTestVisible="False" />

        <StackPanel Margin="{DynamicResource Berth.Space.SettingsPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Restore automatically"
                           Style="{DynamicResource Berth.Type.Body}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />

                <ToggleButton x:Name="RestoreAutomaticallySwitch"
                              Grid.Column="1"
                              Margin="{DynamicResource Berth.Space.ControlGapLeft}"
                              Style="{StaticResource FluentToggleSwitchStyle}"
                              IsChecked="{Binding RestoreAutomatically, Mode=TwoWay}"
                              AutomationProperties.Name="Restore automatically" />
            </Grid>

            <Grid Margin="{DynamicResource Berth.Space.ItemGapTop}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Start with Windows"
                           Style="{DynamicResource Berth.Type.Body}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />

                <ToggleButton x:Name="StartWithWindowsSwitch"
                              Grid.Column="1"
                              Margin="{DynamicResource Berth.Space.ControlGapLeft}"
                              Style="{StaticResource FluentToggleSwitchStyle}"
                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                              AutomationProperties.Name="Start with Windows" />
            </Grid>

            <TextBlock x:Name="VersionCaptionText"
                       Margin="{DynamicResource Berth.Space.ItemGapTop}"
                       Text="{Binding VersionCaption}"
                       Style="{DynamicResource Berth.Type.Caption}"
                       Foreground="{DynamicResource Berth.TextSecondary}" />
        </StackPanel>
    </StackPanel>
</UserControl>
