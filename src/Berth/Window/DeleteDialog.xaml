<Window x:Class="Berth.Window.DeleteDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete layout"
        Width="{DynamicResource Berth.DialogWidth}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnDialogPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid x:Name="DialogRoot"
          Margin="{DynamicResource Berth.Space.DialogPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText"
                   Grid.Row="0"
                   Text="{Binding Message}"
                   Style="{DynamicResource Berth.Type.Body}"
                   TextWrapping="Wrap" />

        <TextBlock x:Name="BusyErrorText"
                   Grid.Row="1"
                   Margin="{DynamicResource Berth.Space.ItemGapTop}"
                   Text="{Binding BusyMessage}"
                   Style="{DynamicResource Berth.Type.Caption}"
                   Foreground="{DynamicResource Berth.NoticeErrorIcon}"
                   TextWrapping="Wrap"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Row="2"
                    Margin="{DynamicResource Berth.Space.SectionGapTop}"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="DeleteButton"
                    Content="Delete"
                    MinWidth="{DynamicResource Berth.DialogButtonMinWidth}"
                    MinHeight="{DynamicResource Berth.ControlHeight}"
                    IsDefault="False"
                    IsEnabled="{Binding CanDelete}"
                    AutomationProperties.Name="Delete"
                    Click="OnDeleteClick" />

            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Style="{DynamicResource AccentButtonStyle}"
                    MinWidth="{DynamicResource Berth.DialogButtonMinWidth}"
                    MinHeight="{DynamicResource Berth.ControlHeight}"
                    Margin="{DynamicResource Berth.Space.ControlGapLeft}"
                    IsDefault="True"
                    IsCancel="True"
                    AutomationProperties.Name="Cancel" />
        </StackPanel>
    </Grid>
</Window>
