<UserControl x:Class="Berth.Window.Notices"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="NoticeBarStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Berth.NoticeWarningFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Berth.NoticeWarningBorder}" />
            <Setter Property="BorderThickness" Value="{DynamicResource Berth.Space.BorderThin}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Berth.RadiusCard}" />
            <Setter Property="Padding" Value="{DynamicResource Berth.Space.ListRow}" />
            <Setter Property="Margin" Value="{DynamicResource Berth.Space.ItemGapBottom}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Berth.NoticeErrorFill}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Berth.NoticeErrorBorder}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NoticeGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Berth.Type.FamilyIcons}" />
            <Setter Property="FontSize" Value="{DynamicResource Berth.NoticeGlyph}" />
            <Setter Property="Foreground" Value="{DynamicResource Berth.NoticeWarningIcon}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="{DynamicResource Berth.Space.NoticeGlyphOffset}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Berth.NoticeErrorIcon}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Padding="{DynamicResource Berth.Space.NoticesContainer}"
            Visibility="{Binding HasNotices, Converter={StaticResource BoolToVisibility}}">
        <ScrollViewer x:Name="NoticesScrollViewer"
                      MaxHeight="{DynamicResource Berth.NoticesMaxHeight}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <ItemsControl x:Name="NoticesItems"
                          ItemsSource="{Binding Items}"
                          Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource NoticeBarStyle}">
                            <Grid MinHeight="{DynamicResource Berth.ControlHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Glyph}"
                                           Style="{StaticResource NoticeGlyphStyle}"
                                           AutomationProperties.Name="{Binding SeverityName}" />

                                <TextBlock Grid.Column="1"
                                           Margin="{DynamicResource Berth.Space.StatusSentence}"
                                           Text="{Binding Text}"
                                           Style="{DynamicResource Berth.Type.Body}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Top" />

                                <Button Grid.Column="2"
                                        Margin="{DynamicResource Berth.Space.SectionGapLeft}"
                                        Content="{Binding ButtonText}"
                                        Command="{Binding ActionCommand}"
                                        MinHeight="{DynamicResource Berth.ControlHeight}"
                                        VerticalAlignment="Top"
                                        AutomationProperties.Name="{Binding ButtonText}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
