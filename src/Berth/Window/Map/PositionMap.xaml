<UserControl x:Class="Berth.Window.Map.PositionMap"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:map="clr-namespace:Berth.Window.Map">
    <UserControl.Resources>
        <map:CornerRadiusToDoubleConverter x:Key="CornerRadiusToDouble" />

        <DataTemplate x:Key="InPlaceMarkerTemplate">
            <Grid Width="{DynamicResource Berth.MarkerTarget}"
                  Height="{DynamicResource Berth.MarkerTarget}"
                  Background="Transparent"
                  ClipToBounds="False">
                <Rectangle x:Name="MarkerVisual"
                           Width="{DynamicResource Berth.Marker}"
                           Height="{DynamicResource Berth.Marker}"
                           RadiusX="{Binding Source={StaticResource Berth.RadiusMarker}, Converter={StaticResource CornerRadiusToDouble}}"
                           RadiusY="{Binding Source={StaticResource Berth.RadiusMarker}, Converter={StaticResource CornerRadiusToDouble}}"
                           Fill="{DynamicResource Berth.MarkerInPlace}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="MarkerVisual" Property="Fill" Value="{DynamicResource Berth.MarkerSelected}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="MovedMarkerTemplate">
            <Grid Width="{DynamicResource Berth.MarkerTarget}"
                  Height="{DynamicResource Berth.MarkerTarget}"
                  Background="Transparent"
                  ClipToBounds="False">
                <Rectangle x:Name="MarkerVisual"
                           Width="{DynamicResource Berth.Marker}"
                           Height="{DynamicResource Berth.Marker}"
                           RadiusX="{Binding Source={StaticResource Berth.RadiusMarker}, Converter={StaticResource CornerRadiusToDouble}}"
                           RadiusY="{Binding Source={StaticResource Berth.RadiusMarker}, Converter={StaticResource CornerRadiusToDouble}}"
                           Fill="Transparent"
                           Stroke="{DynamicResource Berth.MarkerMoved}"
                           StrokeThickness="{DynamicResource Berth.MarkerMovedStroke}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="MarkerVisual" Property="Fill" Value="{DynamicResource Berth.MarkerSelected}" />
                    <Setter TargetName="MarkerVisual" Property="Stroke" Value="Transparent" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="MissingMarkerTemplate">
            <Grid Width="{DynamicResource Berth.MarkerTarget}"
                  Height="{DynamicResource Berth.MarkerTarget}"
                  Background="Transparent"
                  ClipToBounds="False">
                <Rectangle x:Name="MarkerVisual"
                           Width="{DynamicResource Berth.Marker}"
                           Height="{DynamicResource Berth.Marker}"
                           RadiusX="{Binding Source={StaticResource Berth.RadiusMarker}, Converter={StaticResource CornerRadiusToDouble}}"
                           RadiusY="{Binding Source={StaticResource Berth.RadiusMarker}, Converter={StaticResource CornerRadiusToDouble}}"
                           Fill="Transparent"
                           Stroke="{DynamicResource Berth.MarkerMissing}"
                           StrokeThickness="{DynamicResource Berth.MarkerMissingStroke}"
                           StrokeDashArray="2,2"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="MarkerVisual" Property="Fill" Value="{DynamicResource Berth.MarkerSelected}" />
                    <Setter TargetName="MarkerVisual" Property="Stroke" Value="Transparent" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="NeutralMarkerTemplate">
            <Grid Width="{DynamicResource Berth.MarkerTarget}"
                  Height="{DynamicResource Berth.MarkerTarget}"
                  Background="Transparent"
                  ClipToBounds="False">
                <Rectangle x:Name="MarkerVisual"
                           Width="{DynamicResource Berth.Marker}"
                           Height="{DynamicResource Berth.Marker}"
                           RadiusX="{Binding Source={StaticResource Berth.RadiusMarker}, Converter={StaticResource CornerRadiusToDouble}}"
                           RadiusY="{Binding Source={StaticResource Berth.RadiusMarker}, Converter={StaticResource CornerRadiusToDouble}}"
                           Fill="{DynamicResource Berth.MarkerNeutral}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="MarkerVisual" Property="Fill" Value="{DynamicResource Berth.MarkerSelected}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <map:MarkerTemplateSelector x:Key="MarkerTemplateSelector"
                                    InPlaceTemplate="{StaticResource InPlaceMarkerTemplate}"
                                    MovedTemplate="{StaticResource MovedMarkerTemplate}"
                                    MissingTemplate="{StaticResource MissingMarkerTemplate}"
                                    NeutralTemplate="{StaticResource NeutralMarkerTemplate}" />
    </UserControl.Resources>

    <Border Padding="{DynamicResource Berth.Space.DetailSection}">
        <Border x:Name="MapCard"
                MinHeight="{DynamicResource Berth.MapMinHeight}"
                Background="{DynamicResource Berth.MapBackground}"
                BorderBrush="{DynamicResource Berth.MapBorder}"
                BorderThickness="{DynamicResource Berth.Space.BorderThin}"
                CornerRadius="{DynamicResource Berth.RadiusCard}"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="MapViewport" Grid.Row="0" ClipToBounds="True" SizeChanged="OnViewportSizeChanged">
                    <map:MapSurface x:Name="Surface"
                                    IsHitTestVisible="False"
                                    GridBrush="{DynamicResource Berth.MapGrid}"
                                    MonitorFill="{DynamicResource Berth.MonitorFill}"
                                    MonitorStroke="{DynamicResource Berth.MonitorStroke}"
                                    LabelBrush="{DynamicResource Berth.TextSecondary}"
                                    MovedLineBrush="{DynamicResource Berth.MarkerMoved}"
                                    SelectedLineBrush="{DynamicResource Berth.MarkerSelected}" />

                    <ListBox x:Name="MarkersList"
                             Background="Transparent"
                             BorderThickness="{DynamicResource Berth.Space.None}"
                             Padding="{DynamicResource Berth.Space.None}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             SelectionMode="Single"
                             SelectionChanged="OnMarkersSelectionChanged"
                             PreviewKeyDown="OnMarkersPreviewKeyDown"
                             KeyboardNavigation.TabNavigation="Once"
                             ItemTemplateSelector="{StaticResource MarkerTemplateSelector}"
                             AutomationProperties.Name="Saved icon positions">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                                <Setter Property="Width" Value="{DynamicResource Berth.MarkerTarget}" />
                                <Setter Property="Height" Value="{DynamicResource Berth.MarkerTarget}" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="{DynamicResource Berth.Space.None}" />
                                <Setter Property="Margin" Value="{DynamicResource Berth.Space.None}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="ToolTip" Value="{Binding DisplayName}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <map:UnclippedMarkerHost Background="Transparent" ClipToBounds="False">
                                                <Rectangle x:Name="SelectionRing"
                                                           Width="{DynamicResource Berth.MarkerSelectedRing}"
                                                           Height="{DynamicResource Berth.MarkerSelectedRing}"
                                                           RadiusX="{Binding Source={StaticResource Berth.RadiusMarkerSelectedRing}, Converter={StaticResource CornerRadiusToDouble}}"
                                                           RadiusY="{Binding Source={StaticResource Berth.RadiusMarkerSelectedRing}, Converter={StaticResource CornerRadiusToDouble}}"
                                                           Fill="Transparent"
                                                           Stroke="{DynamicResource Berth.MarkerSelected}"
                                                           StrokeThickness="{DynamicResource Berth.MarkerMovedStroke}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"
                                                           Visibility="Collapsed" />
                                                <Rectangle x:Name="FocusRingOuter"
                                                           Width="{DynamicResource Berth.MarkerFocusRingOuter}"
                                                           Height="{DynamicResource Berth.MarkerFocusRingOuter}"
                                                           RadiusX="{Binding Source={StaticResource Berth.RadiusMarkerFocusRingOuter}, Converter={StaticResource CornerRadiusToDouble}}"
                                                           RadiusY="{Binding Source={StaticResource Berth.RadiusMarkerFocusRingOuter}, Converter={StaticResource CornerRadiusToDouble}}"
                                                           Fill="Transparent"
                                                           Stroke="{DynamicResource FocusStrokeColorOuterBrush}"
                                                           StrokeThickness="{DynamicResource Berth.MarkerMovedStroke}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"
                                                           Visibility="Collapsed" />
                                                <Rectangle x:Name="FocusRingInner"
                                                           Width="{DynamicResource Berth.MarkerFocusRingInner}"
                                                           Height="{DynamicResource Berth.MarkerFocusRingInner}"
                                                           RadiusX="{Binding Source={StaticResource Berth.RadiusMarkerFocusRingInner}, Converter={StaticResource CornerRadiusToDouble}}"
                                                           RadiusY="{Binding Source={StaticResource Berth.RadiusMarkerFocusRingInner}, Converter={StaticResource CornerRadiusToDouble}}"
                                                           Fill="Transparent"
                                                           Stroke="{DynamicResource FocusStrokeColorInnerBrush}"
                                                           StrokeThickness="{DynamicResource Berth.MarkerMissingStroke}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"
                                                           Visibility="Collapsed" />
                                                <ContentPresenter />
                                            </map:UnclippedMarkerHost>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="FocusRingOuter" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="FocusRingInner" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Panel.ZIndex" Value="100000" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>

                <Border x:Name="MapFooter"
                        Grid.Row="1"
                        Padding="{DynamicResource Berth.Space.ListRow}"
                        SizeChanged="OnFooterSizeChanged">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                            <TextBlock x:Name="ReadoutPrimaryText"
                                       Text="Select an icon to see its position."
                                       Style="{DynamicResource Berth.Type.MonoStrong}"
                                       Foreground="{DynamicResource Berth.TextSecondary}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ReadoutSecondaryText"
                                       Margin="{DynamicResource Berth.Space.SubtitleTop}"
                                       Text=" "
                                       Style="{DynamicResource Berth.Type.Mono}"
                                       Foreground="{DynamicResource Berth.TextSecondary}"
                                       TextWrapping="Wrap"
                                       Visibility="Hidden" />
                        </StackPanel>

                        <TextBlock x:Name="CountTextBlock"
                                   Grid.Column="1"
                                   Margin="{DynamicResource Berth.Space.ControlGapLeft}"
                                   Style="{DynamicResource Berth.Type.Mono}"
                                   Foreground="{DynamicResource Berth.TextSecondary}"
                                   VerticalAlignment="Bottom" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
