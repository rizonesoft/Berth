<UserControl x:Class="Berth.Window.LayoutsPane"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Berth.Window">
    <UserControl.Resources>
        <DataTemplate x:Key="ActiveBadgeTemplate">
            <Border x:Name="ActiveBadge"
                    Background="{DynamicResource Berth.ActiveBadgeFill}"
                    CornerRadius="{DynamicResource Berth.RadiusBadge}"
                    Padding="{DynamicResource Berth.Space.BadgePadding}"
                    VerticalAlignment="Center">
                <TextBlock x:Name="ActiveBadgeText"
                           Text="Active"
                           Style="{DynamicResource Berth.Type.Caption}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Berth.ActiveBadgeText}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText"
                   Grid.Row="0"
                   Text="Layouts"
                   Style="{DynamicResource Berth.Type.BodyStrong}"
                   Margin="{DynamicResource Berth.Space.PaneHeading}" />

        <ListBox x:Name="LayoutsList"
                 Grid.Row="1"
                 ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 SelectionMode="Single"
                 SelectionChanged="OnSelectionChanged"
                 BorderThickness="{DynamicResource Berth.Space.None}"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Layouts">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="{DynamicResource Berth.Space.None}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="{DynamicResource Berth.ControlHeight}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="SelectionMarker"
                                Grid.Column="0"
                                Width="{DynamicResource Berth.SelectionMarker}"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="Hidden"
                                IsHitTestVisible="False" />

                        <Grid Grid.Column="1" Margin="{DynamicResource Berth.Space.ListRow}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="RowNameText"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding Name}"
                                       Style="{DynamicResource Berth.Type.BodyStrong}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding Name}" />

                            <TextBlock x:Name="RowSubtitleText"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="{DynamicResource Berth.Space.SubtitleTop}"
                                       Text="{Binding Subtitle}"
                                       Style="{DynamicResource Berth.Type.Caption}"
                                       Foreground="{DynamicResource Berth.TextSecondary}"
                                       TextWrapping="Wrap" />

                            <ContentControl x:Name="ActiveBadgeHost"
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Grid.Column="1"
                                            Margin="{DynamicResource Berth.Space.BadgeLeft}"
                                            VerticalAlignment="Center"
                                            Focusable="False"
                                            Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ActiveBadgeTemplate}" />
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Grid>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="SelectionMarker" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ContentControl x:Name="FooterHost"
                        Grid.Row="2"
                        Focusable="False">
            <local:SettingsPanel x:Name="SettingsPanelControl"
                                 DataContext="{Binding Settings}">
                <local:SettingsPanel.Style>
                    <Style TargetType="local:SettingsPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <Trigger Property="DataContext" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </local:SettingsPanel.Style>
            </local:SettingsPanel>
        </ContentControl>
    </Grid>
</UserControl>
