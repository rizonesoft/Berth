<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>berth</AssemblyName>
    <RootNamespace>Berth</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>..\..\assets\icon\berth.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- LibraryImport generates its marshalling as unsafe code (the file writer's GetFinalPathNameByHandle, and the shell interop of D02). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WFO0003 asks Windows Forms apps to set DPI through Application.SetHighDpiMode. Berth is a WPF process:
         WPF takes per-monitor v2 awareness from the manifest, and Windows Forms only hosts the NotifyIcon and
         never runs Application.Run, so the manifest is the layer that owns DPI awareness here. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- WPF's mixed-mode C++/CLI DirectWriteForwarder.dll throws BadImageFormatException when loaded from an
         in-memory single-file bundle without extraction, so self-extracting all bundled content is required. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <NoWarn>$(NoWarn);NETSDK1244</NoWarn>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Berth.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\icon\berth.ico" Link="Assets\berth.ico" />
    <EmbeddedResource Include="..\..\assets\icon\berth-tray-dark.ico" LogicalName="Berth.Assets.berth-tray-dark.ico" />
    <EmbeddedResource Include="..\..\assets\icon\berth-tray-light.ico" LogicalName="Berth.Assets.berth-tray-light.ico" />
  </ItemGroup>

  <!-- The preprocessor symbols the compiler defines for berth.exe, read by the layer rule test in tests/Berth.Tests. -->
  <Target Name="GetBerthDefineConstants" DependsOnTargets="AddImplicitDefineConstants" Returns="$(DefineConstants)" />

</Project>
